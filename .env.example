# Shared local defaults. Copy to .env for local development.
NODE_ENV=development

# The frontend reads this value through Vite.
VITE_SERVICE_BASE_URL=http://localhost:4000

# The service reads this value when starting locally.
SERVICE_PORT=4000

# Local development defaults to an in-memory study shell store. Use dynamodb
# after starting DynamoDB Local and creating/resetting tables.
STUDY_SHELL_STORE=memory
CONSENT_VERSION_STORE=memory
